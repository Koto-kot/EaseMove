  "text": {
    "title": "Встати — сісти зі стільця",
    "shortTitle": "Встати — сісти",
    "cardDescription": "Повільно встаньте зі стільця та контрольовано сядьте назад.",
    "categoryLabel": "Коліна",
    "purpose": "Функціональна вправа для м'язів ніг і контрольованого переходу між сидінням та стоянням.",
    "startPositionTitle": "Початкове положення",
    "startPosition": "Сядьте ближче до переднього краю стійкого стільця. Поставте стопи на підлогу приблизно на ширині таза. Дивіться вперед.",
    "instructionsTitle": "Як виконувати",
    "instructions": [
      {
        "step": 1,
        "text": "Сядьте ближче до переднього краю стільця."
      },
      {
        "step": 2,
        "text": "Поставте стопи впевнено на підлогу."
      },
      {
        "step": 3,
        "text": "Трохи нахиліть корпус уперед."
      },
      {
        "step": 4,
        "text": "Плавно встаньте, випрямляючи ноги."
      },
      {
        "step": 5,
        "text": "Повністю випростайтеся і відчуйте стійке положення."
      },
      {
        "step": 6,
        "text": "Повільно зігніть коліна й стегна та сядьте назад."
      },
      {
        "step": 7,
        "text": "Повторіть задану кількість разів."
      }
    ],
    "techniqueTipsTitle": "Зверніть увагу",
    "techniqueTips": [
      "Дивіться вперед, а не в підлогу.",
      "Не падайте на стілець — сідайте контрольовано.",
      "Стопи залишаються на підлозі.",
      "Перед сіданням повністю випростайтеся.",
      "Використовуйте руки лише відповідно до обраного безпечного варіанта."
    ],
    "safetyLabel": "Безпека",
    "safety": "Використовуйте тільки стійкий стілець без коліс. Якщо з'явилося запаморочення, втрата рівноваги, різкий біль або інший незвичний симптом, натисніть «Стоп».",
    "completion": "Готово."
  },
