  "text": {
    "title": "Почергове згинання рук",
    "shortTitle": "Почергово",
    "cardDescription": "Сидячи, по черзі згинайте праву та ліву руку в лікті.",
    "categoryLabel": "Лікті",
    "purpose": "М’яка почергова вправа для ліктів і рук без опору.",
    "startPositionTitle": "Початкове положення",
    "startPosition": "Сядьте рівно на стійкий стілець. Стопи повністю на підлозі, коліна приблизно під прямим кутом. Обидві руки вздовж тулуба, плечі розслаблені.",
    "instructionsTitle": "Як виконувати",
    "instructions": [
      {
        "step": 1,
        "text": "Сядьте рівно, руки опустіть уздовж тулуба."
      },
      {
        "step": 2,
        "text": "Зігніть праву руку в лікті, підводячи кисть до рівня плеча."
      },
      {
        "step": 3,
        "text": "Опустіть праву руку й одразу зігніть ліву."
      },
      {
        "step": 4,
        "text": "Продовжуйте почергово, плавно та без поспіху."
      }
    ],
    "techniqueTipsTitle": "Зверніть увагу",
    "techniqueTips": [
      "Корпус залишається вертикальним, без розгойдування.",
      "Плечі опущені та розслаблені.",
      "Рука, яка не працює, вільно висить уздовж тулуба."
    ],
    "safetyLabel": "Безпека",
    "safety": "Рухайтеся в комфортному діапазоні. Якщо з'явився різкий біль або інший незвичний симптом, натисніть «Стоп».",
    "completion": "Готово."
  },
