  "text": {
    "title": "Повороти голови",
    "shortTitle": "Повороти",
    "cardDescription": "Повільно повертайте голову ліворуч і праворуч.",
    "categoryLabel": "Шия",
    "purpose": "Легка вправа на рухливість шиї.",
    "startPositionTitle": "Початкове положення",
    "startPosition": "Сядьте рівно на стійкий стілець. Поставте стопи на підлогу. Опустіть і розслабте плечі. Дивіться прямо перед собою.\n",
    "instructionsTitle": "Як виконувати",
    "instructions": [
      {
        "step": 1,
        "text": "Повільно поверніть голову ліворуч настільки, наскільки комфортно."
      },
      {
        "step": 2,
        "text": "Утримуйте положення 5 секунд."
      },
      {
        "step": 3,
        "text": "Повільно поверніться в центр."
      },
      {
        "step": 4,
        "text": "Повільно поверніть голову праворуч настільки, наскільки комфортно."
      },
      {
        "step": 5,
        "text": "Утримуйте положення 5 секунд."
      },
      {
        "step": 6,
        "text": "Повільно поверніться в центр."
      },
      {
        "step": 7,
        "text": "Повторіть 3 рази на кожен бік."
      }
    ],
    "techniqueTipsTitle": "Зверніть увагу",
    "techniqueTips": [
      "Плечі залишаються розслабленими.",
      "Не повертайте разом із головою корпус.",
      "Не закидайте і не опускайте підборіддя під час повороту.",
      "Рухайтеся плавно, без ривків."
    ],
    "safetyLabel": "Безпека",
    "safety": "Рухайтеся тільки в комфортному діапазоні. Якщо з'явилося запаморочення, різкий біль або інший незвичний симптом, натисніть «Стоп».\n",
    "completion": "Готово."
  },
