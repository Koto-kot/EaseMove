  "text": {
    "title": "Зігнути — розігнути руки",
    "shortTitle": "Згинання рук",
    "cardDescription": "Сидячи, одночасно згинайте та плавно розгинайте обидві руки в ліктях.",
    "categoryLabel": "Лікті",
    "purpose": "Проста стартова вправа для рухливості рук у ліктьових суглобах. Без гантелей, еспандерів та іншого опору.",
    "startPositionTitle": "Початкове положення",
    "startPosition": "Сядьте рівно на стійкий стілець. Стопи повністю на підлозі, коліна приблизно під прямим кутом. Плечі опущені та розслаблені. Обидві руки вільно опущені вздовж тулуба, лікті близько до боків.",
    "instructionsTitle": "Як виконувати",
    "instructions": [
      {
        "step": 1,
        "text": "Сядьте рівно, стопи поставте на підлогу."
      },
      {
        "step": 2,
        "text": "Руки вільно опустіть уздовж тулуба."
      },
      {
        "step": 3,
        "text": "Одночасно зігніть обидві руки в ліктях, підводячи кисті приблизно до рівня плечей."
      },
      {
        "step": 4,
        "text": "Плавно розігніть руки та поверніться у вихідне положення."
      },
      {
        "step": 5,
        "text": "Повторюйте рух у спокійному темпі до кінця часу."
      }
    ],
    "techniqueTipsTitle": "Зверніть увагу",
    "techniqueTips": [
      "Не піднімайте плечі до вух.",
      "Лікті залишаються близько до тулуба.",
      "Розгинайте руки без жорсткого «замикання» ліктя.",
      "Рух плавний, без ривків."
    ],
    "safetyLabel": "Безпека",
    "safety": "Рухайтеся в комфортному діапазоні. Якщо з'явився різкий біль або інший незвичний симптом, натисніть «Стоп».",
    "completion": "Готово."
