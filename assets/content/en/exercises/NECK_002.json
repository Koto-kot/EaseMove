  "text": {
    "title": "Head turns",
    "shortTitle": "Turns",
    "cardDescription": "Slowly turn your head to the left and to the right.",
    "categoryLabel": "Neck",
    "purpose": "A gentle exercise for neck mobility.",
    "startPositionTitle": "Starting position",
    "startPosition": "Sit up straight on a stable chair. Place your feet on the floor. Drop and relax your shoulders. Look straight ahead.",
    "instructionsTitle": "How to do it",
    "instructions": [
      {
        "step": 1,
        "text": "Slowly turn your head to the left, as far as is comfortable."
      },
      {
        "step": 2,
        "text": "Hold the position for 5 seconds."
      },
      {
        "step": 3,
        "text": "Slowly return to the centre."
      },
      {
        "step": 4,
        "text": "Slowly turn your head to the right, as far as is comfortable."
      },
      {
        "step": 5,
        "text": "Hold the position for 5 seconds."
      },
      {
        "step": 6,
        "text": "Slowly return to the centre."
      },
      {
        "step": 7,
        "text": "Repeat 3 times to each side."
      }
    ],
    "techniqueTipsTitle": "Watch out for",
    "techniqueTips": [
      "Your shoulders stay relaxed.",
      "Do not turn your torso with your head.",
      "Do not raise or drop your chin as you turn.",
      "Move smoothly, with no jerking."
    ],
    "safetyLabel": "Safety",
    "safety": "Move only within a comfortable range. If you feel dizzy, or have sharp pain or any other unusual symptom, press Stop.",
    "completion": "Done."
  },
