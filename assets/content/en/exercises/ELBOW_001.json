  "text": {
    "spokenInstructions": "A simple starter exercise for elbow mobility. No dumbbells, bands or any other resistance. Sit up straight on a stable chair. Feet flat on the floor, knees at about a right angle. Shoulders down and relaxed. Both arms hang freely beside your body, elbows close to your sides. Sit up straight and place your feet on the floor. Let your arms hang freely beside your body. Bend both elbows at the same time, bringing your hands up to about shoulder height. Smoothly straighten your arms and return to the start. Keep repeating at a calm pace until the time is up.",
    "spokenInstructionsAsset": "audio/uk/exercises/ELBOW_001/instructions.m4a",
    "title": "Bend and straighten your arms",
    "shortTitle": "Elbow bends",
    "cardDescription": "Seated, bend and smoothly straighten both elbows at the same time.",
    "categoryLabel": "Elbows",
    "purpose": "A simple starter exercise for elbow mobility. No dumbbells, bands or any other resistance.",
    "startPositionTitle": "Starting position",
    "startPosition": "Sit up straight on a stable chair. Feet flat on the floor, knees at about a right angle. Shoulders down and relaxed. Both arms hang freely beside your body, elbows close to your sides.",
    "instructionsTitle": "How to do it",
    "instructions": [
      {
        "step": 1,
        "text": "Sit up straight and place your feet on the floor."
      },
      {
        "step": 2,
        "text": "Let your arms hang freely beside your body."
      },
      {
        "step": 3,
        "text": "Bend both elbows at the same time, bringing your hands up to about shoulder height."
      },
      {
        "step": 4,
        "text": "Smoothly straighten your arms and return to the start."
      },
      {
        "step": 5,
        "text": "Keep repeating at a calm pace until the time is up."
      }
    ],
    "techniqueTipsTitle": "Watch out for",
    "techniqueTips": [
      "Do not lift your shoulders toward your ears.",
      "Keep your elbows close to your body.",
      "Straighten without locking the elbow.",
      "Move smoothly, with no jerking."
    ],
    "safetyLabel": "Safety",
    "safety": "Move within a comfortable range. If you feel sharp pain or any other unusual symptom, press Stop.",
    "completion": "Done."
  },
