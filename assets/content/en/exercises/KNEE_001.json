  "text": {
    "title": "Seated knee extension",
    "shortTitle": "Knee extension",
    "cardDescription": "Slowly straighten your leg at the knee and lower it under control.",
    "categoryLabel": "Knees",
    "purpose": "A simple seated exercise for knee movement and for the muscles at the front of the thigh.",
    "startPositionTitle": "Starting position",
    "startPosition": "Sit up straight on a stable chair. Place your feet on the floor. Knees bent. Leave enough room in front of you to straighten your leg freely.",
    "instructionsTitle": "How to do it",
    "instructions": [
      {
        "step": 1,
        "text": "Sit up straight and place your feet on the floor."
      },
      {
        "step": 2,
        "text": "Slowly straighten your left leg at the knee."
      },
      {
        "step": 3,
        "text": "Pull your toes toward you."
      },
      {
        "step": 4,
        "text": "Hold the leg straight for 5 seconds."
      },
      {
        "step": 5,
        "text": "Slowly and smoothly lower your foot to the floor."
      },
      {
        "step": 6,
        "text": "Do the set number of repetitions."
      },
      {
        "step": 7,
        "text": "When the app tells you, repeat with the other leg."
      }
    ],
    "techniqueTipsTitle": "Watch out for",
    "techniqueTips": [
      "Do not lean back to lift the leg.",
      "Your thigh stays on the seat.",
      "Do not swing the leg.",
      "Lower it as smoothly as you lift it."
    ],
    "safetyLabel": "Safety",
    "safety": "Move only within a comfortable range. If you feel sharp pain or any other unusual symptom, press Stop.",
    "completion": "Done."
  },
