  "text": {
    "title": "Chin tuck at the wall",
    "shortTitle": "At the wall",
    "cardDescription": "Standing at a wall, gently draw your chin back and return to neutral.",
    "categoryLabel": "Neck",
    "purpose": "An exercise for gentle head-position control, posture and the deep neck muscles.",
    "startPositionTitle": "Starting position",
    "startPosition": "Stand up straight against a wall. Back tall, the back of your head and your upper back touching the wall. Shoulders down and relaxed. Arms hanging freely. Looking straight ahead, chin in a neutral position.",
    "instructionsTitle": "How to do it",
    "instructions": [
      {
        "step": 1,
        "text": "Stand up straight at the wall, keeping the back of your head against it."
      },
      {
        "step": 2,
        "text": "Look straight ahead."
      },
      {
        "step": 3,
        "text": "Gently draw your chin back, as if making a double chin."
      },
      {
        "step": 4,
        "text": "Hold for a few seconds and smoothly return to neutral."
      },
      {
        "step": 5,
        "text": "Keep repeating at a calm pace until the time is up."
      }
    ],
    "techniqueTipsTitle": "Watch out for",
    "techniqueTips": [
      "Do not tip your head back.",
      "Do not drop your chin down.",
      "Your shoulders do not lift.",
      "The movement happens in your neck, not by leaning your whole torso."
    ],
    "safetyLabel": "Safety",
    "safety": "Move within a comfortable range. If you feel sharp pain, dizziness or any other unusual symptom, press Stop.",
    "completion": "Done."
  },
