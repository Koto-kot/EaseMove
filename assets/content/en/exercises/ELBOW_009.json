  "text": {
    "spokenInstructions": "An ordinary movement with no extra equipment: a simple elbow exercise with the wall for support. Stand facing the wall at a comfortable distance. Place your palms on the wall at about chest or shoulder height. Arms straight but not locked at the elbows. Feet flat on the floor. Stand facing a solid wall. Place your palms on the wall at chest or shoulder height. Smoothly bend your elbows and bring your body closer to the wall. Smoothly straighten your arms and return to the start.",
    "spokenInstructionsAsset": "audio/uk/exercises/ELBOW_009/instructions.m4a",
    "title": "Wall push-up",
    "shortTitle": "At the wall",
    "cardDescription": "Standing at a wall, smoothly bend and straighten your arms.",
    "categoryLabel": "Elbows",
    "purpose": "An ordinary movement with no extra equipment: a simple elbow exercise with the wall for support.",
    "startPositionTitle": "Starting position",
    "startPosition": "Stand facing the wall at a comfortable distance. Place your palms on the wall at about chest or shoulder height. Arms straight but not locked at the elbows. Feet flat on the floor.",
    "instructionsTitle": "How to do it",
    "instructions": [
      {
        "step": 1,
        "text": "Stand facing a solid wall."
      },
      {
        "step": 2,
        "text": "Place your palms on the wall at chest or shoulder height."
      },
      {
        "step": 3,
        "text": "Smoothly bend your elbows and bring your body closer to the wall."
      },
      {
        "step": 4,
        "text": "Smoothly straighten your arms and return to the start."
      }
    ],
    "techniqueTipsTitle": "Watch out for",
    "techniqueTips": [
      "Your body moves as one piece.",
      "Do not drop your head toward the wall on its own.",
      "Your feet must not slip: choose a stable surface.",
      "Pick a comfortable distance and range."
    ],
    "safetyLabel": "Safety",
    "safety": "Move within a comfortable range. If you feel sharp pain or any other unusual symptom, press Stop.",
    "completion": "Done."
  },
