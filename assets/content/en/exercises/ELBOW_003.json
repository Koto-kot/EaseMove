  "text": {
    "title": "Arm bends with palms facing in",
    "shortTitle": "Palms facing in",
    "cardDescription": "Seated, bend both elbows while keeping your palms facing inward.",
    "categoryLabel": "Elbows",
    "purpose": "A gentle version of the elbow bend, with the hand in a neutral position.",
    "startPositionTitle": "Starting position",
    "startPosition": "Sit up straight on a stable chair. Feet on the floor, arms beside your body, palms turned inward.",
    "instructionsTitle": "How to do it",
    "instructions": [
      {
        "step": 1,
        "text": "Sit up straight, arms hanging beside your body."
      },
      {
        "step": 2,
        "text": "Turn your palms inward, facing each other."
      },
      {
        "step": 3,
        "text": "Bend both elbows at the same time without changing the position of your hands."
      },
      {
        "step": 4,
        "text": "Smoothly return to the start."
      }
    ],
    "techniqueTipsTitle": "Watch out for",
    "techniqueTips": [
      "Your palms stay turned inward throughout.",
      "Keep your elbows close to your body.",
      "Shoulders do not rise."
    ],
    "safetyLabel": "Safety",
    "safety": "Move within a comfortable range. If you feel sharp pain or any other unusual symptom, press Stop.",
    "completion": "Done."
  },
