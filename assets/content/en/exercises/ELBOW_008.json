  "text": {
    "spokenInstructions": "A simple exercise for the arms and elbows with no equipment. Sit up straight on a stable chair. Both arms are bent overhead: your hands are behind your head and your elbows are opened out to the sides. Sit up straight and place your feet on the floor. Bend both arms overhead, hands behind your head. Smoothly straighten both arms upward. Return your arms to the bent starting position.",
    "spokenInstructionsAsset": "audio/uk/exercises/ELBOW_008/instructions.m4a",
    "title": "Both arms overhead: bend and straighten",
    "shortTitle": "Both arms up",
    "cardDescription": "Seated, straighten and bend both arms above your head.",
    "categoryLabel": "Elbows",
    "purpose": "A simple exercise for the arms and elbows with no equipment.",
    "startPositionTitle": "Starting position",
    "startPosition": "Sit up straight on a stable chair. Both arms are bent overhead: your hands are behind your head and your elbows are opened out to the sides.",
    "instructionsTitle": "How to do it",
    "instructions": [
      {
        "step": 1,
        "text": "Sit up straight and place your feet on the floor."
      },
      {
        "step": 2,
        "text": "Bend both arms overhead, hands behind your head."
      },
      {
        "step": 3,
        "text": "Smoothly straighten both arms upward."
      },
      {
        "step": 4,
        "text": "Return your arms to the bent starting position."
      }
    ],
    "techniqueTipsTitle": "Watch out for",
    "techniqueTips": [
      "Keep your torso upright, without arching your lower back.",
      "Do not lift your shoulders toward your ears.",
      "Stay within a comfortable range."
    ],
    "safetyLabel": "Safety",
    "safety": "Move within a comfortable range. If you feel sharp pain or any other unusual symptom, press Stop.",
    "completion": "Done."
