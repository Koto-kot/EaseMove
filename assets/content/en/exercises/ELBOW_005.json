  "text": {
    "spokenInstructions": "A simple exercise for the elbows and forearms with no equipment. The movement comes from the forearms only. Sit up straight on a stable chair. Upper arms by your body, elbows bent to about ninety degrees, forearms pointing forward, palms facing up. Sit up straight and keep your elbows by your body. Start with your palms facing up. Smoothly rotate your forearms so your palms face down. Return to the palms-up position.",
    "spokenInstructionsAsset": "audio/uk/exercises/ELBOW_005/instructions.m4a",
    "title": "Palms up, palms down",
    "shortTitle": "Forearm rotation",
    "cardDescription": "Seated, rotate your forearms so your palms turn up and down.",
    "categoryLabel": "Elbows",
    "purpose": "A simple exercise for the elbows and forearms with no equipment. The movement comes from the forearms only.",
    "startPositionTitle": "Starting position",
    "startPosition": "Sit up straight on a stable chair. Upper arms by your body, elbows bent to about ninety degrees, forearms pointing forward, palms facing up.",
    "instructionsTitle": "How to do it",
    "instructions": [
      {
        "step": 1,
        "text": "Sit up straight and keep your elbows by your body."
      },
      {
        "step": 2,
        "text": "Start with your palms facing up."
      },
      {
        "step": 3,
        "text": "Smoothly rotate your forearms so your palms face down."
      },
      {
        "step": 4,
        "text": "Return to the palms-up position."
      }
    ],
    "techniqueTipsTitle": "Watch out for",
    "techniqueTips": [
      "Keep your elbows by your body.",
      "Only the forearms move; the shoulders stay still.",
      "Move smoothly, within a comfortable range."
    ],
    "safetyLabel": "Safety",
    "safety": "Move within a comfortable range. If you feel sharp pain or any other unusual symptom, press Stop.",
    "completion": "Done."
  },
