  "text": {
    "title": "Alternating arm bends",
    "shortTitle": "Alternating",
    "cardDescription": "Seated, bend your right and left arm at the elbow in turn.",
    "categoryLabel": "Elbows",
    "purpose": "A gentle alternating exercise for the elbows and arms, with no resistance.",
    "startPositionTitle": "Starting position",
    "startPosition": "Sit up straight on a stable chair. Feet flat on the floor, knees at about a right angle. Both arms beside your body, shoulders relaxed.",
    "instructionsTitle": "How to do it",
    "instructions": [
      {
        "step": 1,
        "text": "Sit up straight, arms hanging beside your body."
      },
      {
        "step": 2,
        "text": "Bend your right arm at the elbow, bringing the hand up to shoulder height."
      },
      {
        "step": 3,
        "text": "Lower the right arm and bend the left one straight away."
      },
      {
        "step": 4,
        "text": "Keep alternating, smoothly and without hurrying."
      }
    ],
    "techniqueTipsTitle": "Watch out for",
    "techniqueTips": [
      "Keep your torso upright, with no swaying.",
      "Shoulders stay down and relaxed.",
      "The resting arm hangs freely beside your body."
    ],
    "safetyLabel": "Safety",
    "safety": "Move within a comfortable range. If you feel sharp pain or any other unusual symptom, press Stop.",
    "completion": "Done."
  },
