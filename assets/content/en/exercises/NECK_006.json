  "text": {
    "title": "Diagonal look down",
    "shortTitle": "Diagonal",
    "cardDescription": "Seated, gently lower your head and gaze diagonally left, then right.",
    "categoryLabel": "Neck",
    "purpose": "A starter exercise for gentle neck mobility and for easing stiffness after long sitting.",
    "startPositionTitle": "Starting position",
    "startPosition": "Sit up straight on a stable chair. Feet firmly on the floor, back tall, pelvis steady. Shoulders down and relaxed. Hands on your thighs. Head in a neutral position, looking straight ahead.",
    "instructionsTitle": "How to do it",
    "instructions": [
      {
        "step": 1,
        "text": "Sit up straight and lengthen your back."
      },
      {
        "step": 2,
        "text": "Gently lower your head and gaze diagonally to the left."
      },
      {
        "step": 3,
        "text": "Come back to the centre."
      },
      {
        "step": 4,
        "text": "Lower your head and gaze diagonally to the right in the same way."
      },
      {
        "step": 5,
        "text": "Keep alternating at a calm pace until the time is up."
      }
    ],
    "techniqueTipsTitle": "Watch out for",
    "techniqueTips": [
      "Do not lift your shoulders.",
      "Do not twist your torso.",
      "Your eyes and head move together.",
      "Keep the range comfortable and pain free."
    ],
    "safetyLabel": "Safety",
    "safety": "Move within a comfortable range. If you feel sharp pain, dizziness or any other unusual symptom, press Stop.",
    "completion": "Done."
  },
