  "text": {
    "spokenInstructions": "A gentle lying exercise for knee mobility and for bending the leg under control. Lie on your back. Straighten your legs and relax. The heel of the working leg rests on the surface. Lie comfortably on your back with your legs straight. Slowly slide your left heel toward you. Bend the knee as far as is comfortable. Keep your knee pointing up. Slowly slide the heel back, straightening the leg. Do the set number of repetitions. When the app tells you, repeat with the other leg.",
    "spokenInstructionsAsset": "audio/uk/exercises/KNEE_003/instructions.m4a",
    "title": "Heel slide lying down",
    "shortTitle": "Heel to you",
    "cardDescription": "Slide your heel toward you, bending the knee, then slowly straighten the leg.",
    "categoryLabel": "Knees",
    "purpose": "A gentle lying exercise for knee mobility and for bending the leg under control.",
    "startPositionTitle": "Starting position",
    "startPosition": "Lie on your back. Straighten your legs and relax. The heel of the working leg rests on the surface.",
    "instructionsTitle": "How to do it",
    "instructions": [
      {
        "step": 1,
        "text": "Lie comfortably on your back with your legs straight."
      },
      {
        "step": 2,
        "text": "Slowly slide your left heel toward you."
      },
      {
        "step": 3,
        "text": "Bend the knee as far as is comfortable."
      },
      {
        "step": 4,
        "text": "Keep your knee pointing up."
      },
      {
        "step": 5,
        "text": "Slowly slide the heel back, straightening the leg."
      },
      {
        "step": 6,
        "text": "Do the set number of repetitions."
      },
      {
        "step": 7,
        "text": "When the app tells you, repeat with the other leg."
      }
    ],
    "techniqueTipsTitle": "Watch out for",
    "techniqueTips": [
      "The heel stays on the surface.",
      "The knee does not fall to the side.",
      "Your pelvis stays quiet.",
      "Move smoothly, with no jerking."
    ],
    "safetyLabel": "Safety",
    "safety": "Move only within a comfortable range. If you feel sharp pain or any other unusual symptom, press Stop.",
    "completion": "Done."
  },
