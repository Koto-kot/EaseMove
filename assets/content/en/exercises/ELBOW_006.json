  "text": {
    "title": "Hands to shoulders, then forward",
    "shortTitle": "Shoulders and forward",
    "cardDescription": "Seated, straighten both arms forward and bring your hands back to your shoulders.",
    "categoryLabel": "Elbows",
    "purpose": "A simple exercise for the elbows and arms with no equipment.",
    "startPositionTitle": "Starting position",
    "startPosition": "Sit up straight on a stable chair. Feet on the floor, both hands beside your shoulders, elbows bent, shoulders down.",
    "instructionsTitle": "How to do it",
    "instructions": [
      {
        "step": 1,
        "text": "Sit up straight and bring your hands beside your shoulders."
      },
      {
        "step": 2,
        "text": "Smoothly straighten both arms forward at chest or shoulder height."
      },
      {
        "step": 3,
        "text": "Bring your hands back to your shoulders."
      },
      {
        "step": 4,
        "text": "Keep repeating calmly, with no jerking."
      }
    ],
    "techniqueTipsTitle": "Watch out for",
    "techniqueTips": [
      "Keep your torso upright.",
      "Do not lift your shoulders toward your ears.",
      "Elbows almost straight, but not locked."
    ],
    "safetyLabel": "Safety",
    "safety": "Move within a comfortable range. If you feel sharp pain or any other unusual symptom, press Stop.",
    "completion": "Done."
  },
