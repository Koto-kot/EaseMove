  "text": {
    "title": "Isometric: palm to back of head",
    "shortTitle": "Palm behind head",
    "cardDescription": "Seated, gently press the back of your head into your palm without tipping it back.",
    "categoryLabel": "Neck",
    "purpose": "A gentle isometric exercise for the back of the neck and for holding your head neutral.",
    "startPositionTitle": "Starting position",
    "startPosition": "Sit up straight on a stable chair. Feet firmly on the floor, back tall, pelvis steady. Shoulders down and relaxed. Head in a neutral position, looking straight ahead. Your free hand rests on your thigh.",
    "instructionsTitle": "How to do it",
    "instructions": [
      {
        "step": 1,
        "text": "Sit up straight and keep your neck long."
      },
      {
        "step": 2,
        "text": "Place your palm on the back of your head."
      },
      {
        "step": 3,
        "text": "Gently press the back of your head into your palm, and your palm back against it."
      },
      {
        "step": 4,
        "text": "Your head stays put; hold for a few seconds."
      },
      {
        "step": 5,
        "text": "Ease off the pressure and keep repeating until the time is up."
      }
    ],
    "techniqueTipsTitle": "Watch out for",
    "techniqueTips": [
      "Do not press hard.",
      "Do not tip your head back.",
      "Do not lift your shoulders.",
      "Do not hold your breath."
    ],
    "safetyLabel": "Safety",
    "safety": "Move within a comfortable range. If you feel sharp pain, dizziness or any other unusual symptom, press Stop.",
    "completion": "Done."
  },
