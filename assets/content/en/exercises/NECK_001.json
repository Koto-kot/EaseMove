  "text": {
    "title": "Chin tuck",
    "shortTitle": "Chin back",
    "cardDescription": "Seated, gently draw your chin back and return to neutral.",
    "categoryLabel": "Neck",
    "purpose": "A starter exercise for waking the neck up gently and finding a good head position.",
    "startPositionTitle": "Starting position",
    "startPosition": "Sit up straight on a stable chair. Feet firmly on the floor. Shoulders relaxed. Head level, looking straight ahead. Hands resting by your sides or on your thighs.",
    "instructionsTitle": "How to do it",
    "instructions": [
      {
        "step": 1,
        "text": "Sit up straight and place your feet on the floor."
      },
      {
        "step": 2,
        "text": "Look straight ahead."
      },
      {
        "step": 3,
        "text": "Gently draw your chin back — the movement goes back, not down."
      },
      {
        "step": 4,
        "text": "Smoothly return to neutral."
      },
      {
        "step": 5,
        "text": "Keep repeating at a calm pace until the time is up."
      }
    ],
    "techniqueTipsTitle": "Watch out for",
    "techniqueTips": [
      "Keep the movement small and controlled.",
      "Do not tip your head back.",
      "Do not drop your head down as you move.",
      "Do not lift your shoulders."
    ],
    "safetyLabel": "Safety",
    "safety": "Move within a comfortable range. If you feel sharp pain or any other unusual symptom, press Stop.",
    "completion": "Done."
  },
