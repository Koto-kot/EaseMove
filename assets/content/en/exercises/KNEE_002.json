  "text": {
    "spokenInstructions": "A functional exercise for the leg muscles and for moving between sitting and standing under control. Sit closer to the front edge of a stable chair. Place your feet on the floor about hip width apart. Look ahead. Sit closer to the front edge of the chair. Plant your feet firmly on the floor. Lean your torso forward a little. Stand up smoothly, straightening your legs. Straighten up fully and feel steady. Slowly bend your knees and hips and sit back down. Do the set number of repetitions.",
    "spokenInstructionsAsset": "audio/uk/exercises/KNEE_002/instructions.m4a",
    "title": "Sit to stand",
    "shortTitle": "Stand and sit",
    "cardDescription": "Slowly stand up from the chair and sit back down under control.",
    "categoryLabel": "Knees",
    "purpose": "A functional exercise for the leg muscles and for moving between sitting and standing under control.",
    "startPositionTitle": "Starting position",
    "startPosition": "Sit closer to the front edge of a stable chair. Place your feet on the floor about hip width apart. Look ahead.",
    "instructionsTitle": "How to do it",
    "instructions": [
      {
        "step": 1,
        "text": "Sit closer to the front edge of the chair."
      },
      {
        "step": 2,
        "text": "Plant your feet firmly on the floor."
      },
      {
        "step": 3,
        "text": "Lean your torso forward a little."
      },
      {
        "step": 4,
        "text": "Stand up smoothly, straightening your legs."
      },
      {
        "step": 5,
        "text": "Straighten up fully and feel steady."
      },
      {
        "step": 6,
        "text": "Slowly bend your knees and hips and sit back down."
      },
      {
        "step": 7,
        "text": "Do the set number of repetitions."
      }
    ],
    "techniqueTipsTitle": "Watch out for",
    "techniqueTips": [
      "Look ahead, not at the floor.",
      "Do not drop onto the chair — sit down under control.",
      "Your feet stay on the floor.",
      "Straighten up fully before sitting down.",
      "Use your hands only as the safe variant you chose allows."
    ],
    "safetyLabel": "Safety",
    "safety": "Use only a stable chair without wheels. If you feel dizzy, lose your balance, or have sharp pain or any other unusual symptom, press Stop.",
    "completion": "Done."
  },
