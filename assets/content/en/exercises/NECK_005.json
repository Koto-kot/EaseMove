  "text": {
    "spokenInstructions": "A gentle neck movement that suits short daily breaks. This is not a full head tip back. Sit up straight on a stable chair. Feet firmly on the floor, pelvis steady. Back tall, without arching. Shoulders down and relaxed. Hands on your thighs. Head in a neutral position, looking straight ahead. Sit up straight and let your shoulders drop. Look straight ahead. Gently lift your chin and your gaze a little. Smoothly return to a neutral head position. Keep repeating at a calm pace until the time is up.",
    "spokenInstructionsAsset": "audio/uk/exercises/NECK_005/instructions.m4a",
    "title": "Look slightly up",
    "shortTitle": "Look up",
    "cardDescription": "Seated, lift your chin and your gaze a little, then return to neutral.",
    "categoryLabel": "Neck",
    "purpose": "A gentle neck movement that suits short daily breaks. This is not a full head tip back.",
    "startPositionTitle": "Starting position",
    "startPosition": "Sit up straight on a stable chair. Feet firmly on the floor, pelvis steady. Back tall, without arching. Shoulders down and relaxed. Hands on your thighs. Head in a neutral position, looking straight ahead.",
    "instructionsTitle": "How to do it",
    "instructions": [
      {
        "step": 1,
        "text": "Sit up straight and let your shoulders drop."
      },
      {
        "step": 2,
        "text": "Look straight ahead."
      },
      {
        "step": 3,
        "text": "Gently lift your chin and your gaze a little."
      },
      {
        "step": 4,
        "text": "Smoothly return to a neutral head position."
      },
      {
        "step": 5,
        "text": "Keep repeating at a calm pace until the time is up."
      }
    ],
    "techniqueTipsTitle": "Watch out for",
    "techniqueTips": [
      "Keep the range small and comfortable.",
      "Do not tip your head sharply back.",
      "Do not arch your torso along with your head.",
      "Do not lift your shoulders."
    ],
    "safetyLabel": "Safety",
    "safety": "Move within a comfortable range. If you feel sharp pain, dizziness or any other unusual symptom, press Stop.",
    "completion": "Done."
  },
