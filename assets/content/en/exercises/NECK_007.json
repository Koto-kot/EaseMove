  "text": {
    "spokenInstructions": "A gentle isometric exercise for the neck muscles and for head-position control. Sit up straight on a stable chair. Feet firmly on the floor, back tall, pelvis steady. Shoulders down and relaxed. Head in a neutral position, looking straight ahead. One hand rests on your thigh, the other is ready to meet your forehead. Sit up straight and keep your head level. Place your palm on the centre of your forehead, elbow loosely bent. Gently press your forehead into your palm, and your palm back against it. Your head stays put; hold for a few seconds. Ease off the pressure and keep repeating until the time is up.",
    "spokenInstructionsAsset": "audio/uk/exercises/NECK_007/instructions.m4a",
    "title": "Isometric: palm to forehead",
    "shortTitle": "Palm to forehead",
    "cardDescription": "Seated, gently press your forehead into your palm, with almost no head movement.",
    "categoryLabel": "Neck",
    "purpose": "A gentle isometric exercise for the neck muscles and for head-position control.",
    "startPositionTitle": "Starting position",
    "startPosition": "Sit up straight on a stable chair. Feet firmly on the floor, back tall, pelvis steady. Shoulders down and relaxed. Head in a neutral position, looking straight ahead. One hand rests on your thigh, the other is ready to meet your forehead.",
    "instructionsTitle": "How to do it",
    "instructions": [
      {
        "step": 1,
        "text": "Sit up straight and keep your head level."
      },
      {
        "step": 2,
        "text": "Place your palm on the centre of your forehead, elbow loosely bent."
      },
      {
        "step": 3,
        "text": "Gently press your forehead into your palm, and your palm back against it."
      },
      {
        "step": 4,
        "text": "Your head stays put; hold for a few seconds."
      },
      {
        "step": 5,
        "text": "Ease off the pressure and keep repeating until the time is up."
      }
    ],
    "techniqueTipsTitle": "Watch out for",
    "techniqueTips": [
      "Do not press hard.",
      "Your head neither tips back nor leans forward.",
      "Keep your shoulders relaxed.",
      "Breathe calmly; do not hold your breath."
    ],
    "safetyLabel": "Safety",
    "safety": "Move within a comfortable range. If you feel sharp pain, dizziness or any other unusual symptom, press Stop.",
    "completion": "Done."
  },
