  "text": {
    "title": "Діагональний погляд вниз",
    "shortTitle": "Діагональ",
    "cardDescription": "Сидячи, м'яко опускайте голову й погляд по діагоналі вліво, потім вправо.",
    "categoryLabel": "Шия",
    "purpose": "Базова вправа на м'яку рухливість шиї та зняття скутості після тривалого сидіння.",
    "startPositionTitle": "Початкове положення",
    "startPosition": "Сядьте рівно на стійкий стілець. Стопи стійко на підлозі, спина витягнута, таз стабільний. Плечі розслаблені й опущені. Руки лежать на стегнах. Голова у нейтральному положенні, погляд прямо.",
    "instructionsTitle": "Як виконувати",
    "instructions": [
      {
        "step": 1,
        "text": "Сядьте рівно, спину витягніть."
      },
      {
        "step": 2,
        "text": "М'яко опустіть голову й погляд по діагоналі вліво."
      },
      {
        "step": 3,
        "text": "Поверніться у центр."
      },
      {
        "step": 4,
        "text": "Так само опустіть голову й погляд по діагоналі вправо."
      },
      {
        "step": 5,
        "text": "Чергуйте напрямки у спокійному темпі до кінця часу."
      }
    ],
    "techniqueTipsTitle": "Зверніть увагу",
    "techniqueTips": [
      "Не піднімайте плечі.",
      "Не скручуйте корпус.",
      "Очі й голова рухаються разом.",
      "Амплітуда лише комфортна, без болю."
    ],
    "safetyLabel": "Безпека",
    "safety": "Рухайтеся в комфортному діапазоні. Якщо з'явився різкий біль, запаморочення або інший незвичний симптом, натисніть «Стоп».",
    "completion": "Готово."
