  "text": {
    "title": "Згинання рук долонями вниз",
    "shortTitle": "Долоні вниз",
    "cardDescription": "Сидячи, підводьте кисті до плечей і повертайте назад, зберігаючи долоні вниз.",
    "categoryLabel": "Лікті",
    "purpose": "Проста вправа для руху в ліктях без ваги та без іншого опору. Це не вправа на обертання передпліч.",
    "startPositionTitle": "Початкове положення",
    "startPosition": "Сядьте рівно на стійкий стілець. Верхні частини рук біля тулуба, лікті зігнуті приблизно на 90°, передпліччя спрямовані вперед, долоні повернуті вниз.",
    "instructionsTitle": "Як виконувати",
    "instructions": [
      {
        "step": 1,
        "text": "Сядьте рівно, стопи поставте на підлогу."
      },
      {
        "step": 2,
        "text": "Зігніть лікті приблизно на 90°, передпліччя вперед, долоні вниз."
      },
      {
        "step": 3,
        "text": "Не повертаючи передпліч, сильніше зігніть лікті та підведіть кисті до плечей."
      },
      {
        "step": 4,
        "text": "Плавно поверніться до положення 90°."
      }
    ],
    "techniqueTipsTitle": "Зверніть увагу",
    "techniqueTips": [
      "Долоні весь час дивляться вниз.",
      "Зап’ястя залишаються прямими.",
      "Плечі не піднімаються, лікті не відходять далеко від тулуба."
    ],
    "safetyLabel": "Безпека",
    "safety": "Рухайтеся в комфортному діапазоні. Якщо з'явився різкий біль або інший незвичний симптом, натисніть «Стоп».",
    "completion": "Готово."
  },
