  "text": {
    "title": "Нахил голови до плеча",
    "shortTitle": "Нахили голови",
    "cardDescription": "Сидячи, плавно нахиляйте голову до одного плеча, потім до іншого.",
    "categoryLabel": "Шия",
    "purpose": "Базова вправа на м'яку бічну рухливість шиї.",
    "startPositionTitle": "Початкове положення",
    "startPosition": "Сядьте рівно на стійкий стілець. Стопи стійко на підлозі. Плечі розслаблені. Голова у нейтральному положенні, погляд прямо. Руки лежать на стегнах.",
    "instructionsTitle": "Як виконувати",
    "instructions": [
      {
        "step": 1,
        "text": "Сядьте рівно, плечі опустіть і розслабте."
      },
      {
        "step": 2,
        "text": "Плавно нахиліть голову вправо, ведучи вухо до плеча."
      },
      {
        "step": 3,
        "text": "Поверніться у центр."
      },
      {
        "step": 4,
        "text": "Так само плавно нахиліть голову вліво."
      },
      {
        "step": 5,
        "text": "Чергуйте боки у спокійному темпі до кінця часу."
      }
    ],
    "techniqueTipsTitle": "Зверніть увагу",
    "techniqueTips": [
      "Не піднімайте плечі.",
      "Не обертайте голову під час нахилу.",
      "Рух плавний, без ривків.",
      "Не тисніть рукою на голову."
    ],
    "safetyLabel": "Безпека",
    "safety": "Рухайтеся в комфортному діапазоні. Якщо з'явився різкий біль або інший незвичний симптом, натисніть «Стоп».",
    "completion": "Готово."
  },
