  "text": {
    "title": "Підтягування п’яти лежачи",
    "shortTitle": "П’ята до себе",
    "cardDescription": "Ковзайте п’ятою до себе, згинаючи коліно, а потім повільно випряміть ногу.",
    "categoryLabel": "Коліна",
    "purpose": "Легка вправа лежачи для рухливості коліна та контрольованого згинання ноги.",
    "startPositionTitle": "Початкове положення",
    "startPosition": "Ляжте на спину. Випряміть ноги та розслабтеся. П’ята робочої ноги лежить на поверхні.",
    "instructionsTitle": "Як виконувати",
    "instructions": [
      {
        "step": 1,
        "text": "Ляжте зручно на спину, ноги випрямлені."
      },
      {
        "step": 2,
        "text": "Повільно ковзайте лівою п’ятою до себе."
      },
      {
        "step": 3,
        "text": "Згинайте коліно настільки, наскільки комфортно."
      },
      {
        "step": 4,
        "text": "Тримайте коліно спрямованим угору."
      },
      {
        "step": 5,
        "text": "Повільно ковзайте п’ятою назад, випрямляючи ногу."
      },
      {
        "step": 6,
        "text": "Виконайте задану кількість повторів."
      },
      {
        "step": 7,
        "text": "Після сигналу застосунку повторіть іншою ногою."
      }
    ],
    "techniqueTipsTitle": "Зверніть увагу",
    "techniqueTips": [
      "П’ята не відривається від поверхні.",
      "Коліно не завалюється вбік.",
      "Таз залишається спокійним.",
      "Рухайтеся плавно, без ривків."
    ],
    "safetyLabel": "Безпека",
    "safety": "Рухайтеся тільки в комфортному діапазоні. Якщо з’явився різкий біль або інший незвичний симптом, натисніть «Стоп».",
    "completion": "Готово."
  },
