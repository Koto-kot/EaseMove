  "collectionCandidates": [],
  "text": {
    "spokenInstructions": "М'яка ізометрична вправа для бічних м'язів шиї та утримання голови по центру. Сядьте рівно на стійкий стілець. Стопи стійко на підлозі, спина витягнута, таз стабільний. Плечі опущені й розслаблені. Голова у нейтральному положенні, погляд прямо. Вільна рука лежить на стегні. Сядьте рівно, голову тримайте по центру. Прикладіть долоню до скроні справа. М'яко натискайте скронею в долоню, а долонею — назустріч; голова не нахиляється. Послабте напругу і змініть бік. Чергуйте боки у спокійному темпі до кінця часу.",
    "spokenInstructionsAsset": "audio/uk/exercises/NECK_008/instructions.m4a",
    "title": "Ізометрія: долоня до скроні",
    "shortTitle": "Долоня до скроні",
    "cardDescription": "Сидячи, м'яко натискайте скронею в долоню, не нахиляючи голову. Потім змініть бік.",
    "categoryLabel": "Шия",
    "purpose": "М'яка ізометрична вправа для бічних м'язів шиї та утримання голови по центру.",
    "startPositionTitle": "Початкове положення",
    "startPosition": "Сядьте рівно на стійкий стілець. Стопи стійко на підлозі, спина витягнута, таз стабільний. Плечі опущені й розслаблені. Голова у нейтральному положенні, погляд прямо. Вільна рука лежить на стегні.",
    "instructionsTitle": "Як виконувати",
    "instructions": [
      {
        "step": 1,
        "text": "Сядьте рівно, голову тримайте по центру."
      },
      {
        "step": 2,
        "text": "Прикладіть долоню до скроні справа."
      },
      {
        "step": 3,
        "text": "М'яко натискайте скронею в долоню, а долонею — назустріч; голова не нахиляється."
      },
      {
        "step": 4,
        "text": "Послабте напругу і змініть бік."
      },
      {
        "step": 5,
        "text": "Чергуйте боки у спокійному темпі до кінця часу."
      }
    ],
    "techniqueTipsTitle": "Зверніть увагу",
    "techniqueTips": [
      "Не тисніть сильно.",
      "Не нахиляйте голову вбік.",
      "Не піднімайте плечі.",
      "Не затримуйте дихання."
    ],
    "safetyLabel": "Безпека",
    "safety": "Рухайтеся в комфортному діапазоні. Якщо з'явився різкий біль, запаморочення або інший незвичний симптом, натисніть «Стоп».",
    "completion": "Готово."
  },
