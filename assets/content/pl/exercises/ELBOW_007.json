  "text": {
    "title": "Одна рука над головою: зігнути — випрямити",
    "shortTitle": "Рука над головою",
    "cardDescription": "Сидячи, згинайте та випрямляйте одну руку над головою.",
    "categoryLabel": "Лікті",
    "purpose": "Проста вправа для руки і ліктя без обладнання.",
    "startPositionTitle": "Початкове положення",
    "startPosition": "Сядьте рівно на стійкий стілець. Права рука зігнута над головою: лікоть піднятий, кисть за головою. Ліва рука спокійно лежить на стегні.",
    "instructionsTitle": "Як виконувати",
    "instructions": [
      {
        "step": 1,
        "text": "Сядьте рівно, стопи поставте на підлогу."
      },
      {
        "step": 2,
        "text": "Підніміть праву руку та зігніть її над головою."
      },
      {
        "step": 3,
        "text": "Плавно випряміть руку вгору."
      },
      {
        "step": 4,
        "text": "Поверніться у вихідне зігнуте положення."
      }
    ],
    "techniqueTipsTitle": "Зверніть увагу",
    "techniqueTips": [
      "Лікоть дивиться вгору, без відведення вбік.",
      "Корпус залишається рівним, без нахилу вбік.",
      "Рух у комфортному діапазоні, без болю в плечі."
    ],
    "safetyLabel": "Безпека",
    "safety": "Рухайтеся в комфортному діапазоні. Якщо з'явився різкий біль або інший незвичний симптом, натисніть «Стоп».",
    "completion": "Готово."
